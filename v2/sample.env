# Gemini API Key for LLM-powered qualitative feedback
# Required for the hybrid evaluation approach (numerical + AI feedback)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MCP Server URL - set this to your public URL when deploying
# For local development, this is auto-set based on --host and --port
MCP_SERVER_URL=http://localhost:9009/mcp
# Model providers (see config/models.toml; a model runs only if its key is set)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# XAI_API_KEY=
# GROQ_API_KEY=            # free tier (llama-3.3-70b)
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# OPENROUTER_API_KEY=
# MISTRAL_API_KEY=         # free experiment tier
