ft":" Movie Format/Quality Average Bit-rate Image Size AVC HD PS 28 Mbps 1920 x 1080/60p AVC HD FX 24 Mbps 1920 x 1080/60i AVC HD FH 17 Mbps 1920 x 1080/60i MP4 12M 12 Mbps 1440 x 1080/30fps MP4 VGA 3M 3 Mbps 640 x 480/30fps","id_right":2436093,"category_right":"Camera_and_Photo","cluster_id_right":753726,"brand_right":null,"title_right":" \"Sony Cyber-shot® DSC-WX80\"@en \" Sony DSC-WX80 (Black) 16.2-megapixel digital camera with 8X optical zoom and Wi-Fi® at Crutchfield.com \"@en","description_right":"\"16.2-megapixel digital camera with 8X optical zoom and Wi-Fi® (Black)\"@en ","price_right":null,"specTableContent_right":null},"truncated_cells":[]},{"row_idx":101,"row":{"pair_id":"3144831#14792006","label":0,"id_left":3144831,"category_left":"Camera_and_Photo","cluster_id_left":1424676,"brand_left":null,"title_left":" \"Canon - Speedlite 270EX II External Flash\"@en-US","description_left":"\"Enhance the creative power of your digital camera with this external flash that features a wireless slave function and vertical bounce capability. The ultralight, compact design makes it an accessory that's easy to add to your camera bag.\"@en-US ","price_left":null,"specTableContent_left":null,"id_right":14792006,"category_right":"Camera_and_Photo","cluster_id_right":146490,"brand_right":"\"Null\"","title_right":" \"3 in 1 Stacking Grid Light Modifier System for CANON 580EX/ 580EX II Flash Speedlite, SG-C GRID\"","description_right":"\"\nThe Light Modifier was designed to produce 3 different size of light spread (Small, Medium and Large) and when aligned and stacked two grids together, produce the smallest spots of light. Stack the small grid into the bezel to produce large size spots of light, for medium size spots of light just stack the larger size grid into the bezel.\" ","price_right":null,"specTableContent_right":null},"truncated_cells":[]},{"row_idx":102,"row":{"pair_id":"5225361#10525286","label":0,"id_left":5225361,"category_left":"Camera_and_Photo","cluster_id_left