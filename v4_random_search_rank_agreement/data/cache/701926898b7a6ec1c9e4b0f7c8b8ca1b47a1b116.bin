ton\tDecember\t31,\t2008\tand\t2007\tand\tEntergy\tTexas'\tpro\trata\tshare\tof that\t debt.\tAlso\tincluded\tare\tthe\tsecuritization\tbonds\tissued\tby\tEntergy\tGulf\tStates\tReconstruction\tFunding\tthat\tare\tdescribed\tin\tfurther\tdetail below\tin\tthis\tNote.\n\n|  | 2008 | 2007 |\n| :--- | :--- | :--- |\n|  | (In\\tThousands) |  |\n| Mortgage\\tBonds\\tshare\\tassumed\\tunder\\tdebt\\tassumption\\tagreement: |  |  |\n| \\t\\t3.6%\\tSeries\\tdue\\tJune\\t2008 | $- | $148,837 |\n| \\t\\tLibor\\t+\\t0.75%\\tSeries\\tdue\\tDecember\\t2008 | - | 160,286 |\n| \\t\\tLibor\\t+\\t0.4%\\tSeries\\tdue\\tDecember\\t2009 | 100,509 | 100,509 |\n| \\t\\t5.12\\t%\\tSeries\\tdue\\tAugust\\t2010 | 45,796 | 45,796 |\n| \\t\\t4.875%\\tSeries\\tdue\\tNovember\\t2011 | 91,592 | 91,592 |\n| \\t\\t6.0%\\tSeries\\tdue\\tDecember\\t2012 | 64,114 | 64,114 |\n| \\t\\t5.6%\\tSeries\\tdue\\tDecember\\t2014 | 22,898 | 22,898 |\n| \\t\\t5.70%\\tSeries\\tdue\\tJune\\t2015 | 91,592 | 91,592 |\n| \\t\\t5.25%\\tSeries\\tdue\\tAugust\\t2015 | 91,592 | 91,592 |\n| \\t\\t6.2%\\tSeries\\tdue\\tJuly\\t2033 | 109,911 | 109,911 |\n| \\t\\t6.18%\\tSeries\\tdue\\tMarch\\t2035 | 38,927 | 38,927 |\n| \\t\\tTotal\\tmortgage\\tbonds | 656,931 | 966,054 |\n| Governmental\\tBonds\\tshare\\tassumed\\tunder\\tdebt\\tassumption\\tagreement\\t(a): |  |  |\n| \\t\\t5.45%\\tSeries\\tdue\\t2010,\\tCalcasieu\\tParish | 10,120 | 10,120 |\n| \\t\\t6.75%\\tSeries\\tdue\\t2012,\\tCalcasieu\\tParish | 22,115 | 22,115 |\n| \\t\\t6.7%\\tSeries\\tdue\\t2013,\\tPointe\\tCoupee\\tParish | 7,990 | 7,990 |\n| \\t\\t5.7%\\tSeries\\tdue\\t2014,\\tIberville\\tParish | 9,890 | 9,890 |\n| \\t\\t5.8%\\tSeries\\tdue\\t2015,\\tWest\\tFeliciana\\tParish | 13,005 | 13,005 |\n| \\t\\t7.0%\\tSeries\\tdue\\t2015,\\tWest\\tFeliciana\\tParish | 22,440 | 22,440 |\n| \\t\\t5.8%\\tSeries\\tdue\\t2016,\\tWest\\tFeliciana\\tParish | 9,160 | 9,160 |\n| \\t\\t6.6%\\tSeries\\tdue\\t2028,\\tWest\\tFeliciana\\tParish | 18,320 | 18,320 |\n| \\t\\tTotal