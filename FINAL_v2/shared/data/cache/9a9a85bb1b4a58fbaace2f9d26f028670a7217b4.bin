249,"row":{"pair_id":"16583485#2271998","label":1,"id_left":16583485,"category_left":"Computers_and_Accessories","cluster_id_left":699163,"brand_left":null,"title_left":" \"MEMORIA USB 16GB KINGSTON DATATRAVELER G4\"","description_left":"\"MEMORIA USB 16GB KINGSTON DATATRAVELER G4 AZUL 3.0\" ","price_left":null,"specTableContent_left":null,"id_right":2271998,"category_right":"Computers_and_Accessories","cluster_id_right":699163,"brand_right":null,"title_right":" \"PENDRIVE 16GB KINGSTON USB 3.0 DATATRAVELER G4\"@es \"Almacenamiento Disco Duro o Tarjeta? - Tu tienda online líder con precios más baratos! \"@es","description_right":"\"Kingston DataTraveler G4 - Unidad flash USB - 16 GB - USB 3.0 - azul\"@es ","price_right":null,"specTableContent_right":null},"truncated_cells":[]},{"row_idx":250,"row":{"pair_id":"16637861#1221565","label":0,"id_left":16637861,"category_left":"Computers_and_Accessories","cluster_id_left":107415,"brand_left":"\"Gigabyte\"@en","title_left":" \"Gigabyte Radeon RX 550 Gaming OC 2048MB GDDR5 PCI-Express Graphics Card\"@en \"▷ Gigabyte Gr… | OcUK\"@en","description_left":"\"GV-RX550GAMING OC-2GD, Boost: 1219MHz, Memory: 2048MB 7000MHz GDDR5, Stream Processors: 512, DirectX 12 Support, 3 Years Warranty\"@en ","price_left":null,"specTableContent_left":null,"id_right":1221565,"category_right":"Computers_and_Accessories","cluster_id_right":1687845,"brand_right":null,"title_right":" \"Gigabyte AMD Radeon RX 550 2GB D5 Graphics Card\"@en Card LN80158 - GV-RX550D5-2GD | SCAN UK\"@en","description_right":"\"2GB Gigabyte Radeon RX 550 D5, 14nm Polaris, 512 Streams, 1183MHz GPU, 7000MHz GDDR5, DP/HDMI/DVI-D DL              \"@en ","price_right":null,"specTableContent_right":null},"truncated_cells":[]},{"row_idx":251,"row":{"pair_id":"16479327#8438068","label":0,"id_left":16479327,"category_left":"Computers_and_Accessories","cluster_id_left":1696952,"brand_left":"\"Samsung\"","title_left":" \"Samsung SSD 850 EVO 1TB, SATA 6Gb/s\" 1TB","description_left":"\"Access your data quickly and efficiently with the 1TB 850 Evo 2.5\" SATA III SSD from Samsung. This 1TB solid state drive features sequential read speeds of up to 540 MB/s and sequential write speeds of up to 520 MB/s allowing for the rapid transfer of large files. The integrated SATA 6 Gb/s interface makes installation quick and easy while remaining backwards compatible with SATA II 3 Gb/s and SATA 1.5 Gb/s interfaces. This Samsung SSD even comes with 1GB of low power DDR2 SDRAM used as cache memory to enhance processing speeds.With a 2.5\" form factor, this solid state drive is designed to be used in a variety of notebook and desktop computers. The reduced size is achieved through the use of Samsung's 3D V-NAND flash memory as each of the 32 cell layers are stacked vertically rather than horizontally. Samsung also implements their own TurboWrite technology to deliver enhanced sequential read and write speeds while Rapid Mode software utilizes the integrated cache (DRAM) memory to improve processing speeds. Insert this solid state drive into nearly any notebook computer and you benefit from improved battery life with the enhanced SSD controller allowing the drive to sleep at an efficient 2 mW.\n\" ","price_left":"\"356.99\", \"US$\"","specTableContent_left":" Official Release Date  Nov 10, 2014 Genre  Solid-State Drive (Internal) PAX-Code PAX0006686916 Catalog No.  MZ-75E-1T0BW Item Code  0887276086057 Product Measures 10cm x 7cm x 0.7cm","id_right":8438068,"category_right":"Computers_and_Accessories","cluster_id_right":82722,"brand_right":null,"title_right":" \"SSD Samsung 850 Evo 500Go\"","description_right":"\"Samsung 500GB 850 EVO, 500 Go, Série ATA III, 540 Mo/s, 6,35 cm (2.5\"), Noir, 0,1W\" ","price_right":null,"specTableContent_right":null},"truncated_cells":[]},{"row_idx":252,"row":{"pair_id":"5445961#17228636","label":1,"id_left":5445961,"category_left":"Computers_and_Accessories","cluster_id_left":378377,"brand_left":"\"HP Enterprise\"","title_left":"