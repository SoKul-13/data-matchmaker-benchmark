f').substr(1)).invoke('show');\n                }\n            }\n            title.addClassName('active')\n        }\n\n        table.select('.title a, .title spandata-href').each(function(title,i){\n            title.observe('click',function(e){\n                e.preventDefault();\n                specs.invoke('hide');\n                removeActive();\n                activateMenu(title, table);\n            });\n\n            if (i==0) {\n                activateMenu(title, table);\n            }\n        });\n    });\n\n                \n                        \"@en ","price_left":null,"specTableContent_left":null,"id_right":6203912,"category_right":"Camera_and_Photo","cluster_id_right":823453,"brand_right":null,"title_right":" \"Nikon AF-S Nikkor 35mm f/1.8 G DX Lens\"@en \"Camera Lenses :: Nikon Lens - Onestop Digital\"@en","description_right":"\"To fulfill the needs of digital photographers owning Nikon cameras with DX-sized sensors  Nikon produces the 35mm f/1.8 AF-S DX Lens.  This lens produces an angle of view similar to what a 50mm lens would produce on a full-frame/FX camera and thusly functions as a \"normal\" lens. Prior to the digital explosion  most shooters would begin their exploration into the world of photography with a \"normal\" lens with a large maximum aperture.  \"@en ","price_right":null,"specTableContent_right":null},"truncated_cells":[]},{"row_idx":212,"row":{"pair_id":"14811315#12131666","label":0,"id_left":14811315,"category_left":"Camera_and_Photo","cluster_id_left":571588,"brand_left":null,"title_left":" \"Canon EOS BG-E14 Batterij Grip 70D/80D - Prijzen \"@NL Tweakers\"@NL","description_left":null,"price_left":null,"specTableContent_left":" Categorie Camera-accessoires Merk Canon Productserie EOS Product Canon EOS BG-E14 Batterij Grip 70D/80D Uitvoering Canon EOS BG-E14 Batterij Grip 70D/80D EAN 0013803222210, 4960999981000, 5021252755567 SKU 8471B001, 8471B001AA Tweakers ID 387015 Productprijs € 162,- Pakketpost € 0,- iDeal € 0,- 