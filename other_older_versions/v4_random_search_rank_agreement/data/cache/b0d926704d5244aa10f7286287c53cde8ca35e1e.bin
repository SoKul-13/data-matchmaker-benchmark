return\ton\tinvestments,\tnet\tof\texpenses,\tthat\tis\tequal\tto\tor\texceeds\tvarious\tbenchmark\trates.\n\nThe\tasset\tallocation\tis\treviewed\tperiodically\tto\tdetermine\ta\tsuitable\tasset\tallocation\twhich\tseeks\tto\tmanage\trisk\tthrough\tportfolio\tdiversification\tand\ttakes\tinto account,\tamong\tother\tpossible\tfactors,\tthe\tabove-stated\tobjectives,\tin\tconjunction\twith\tcurrent\tfunding\tlevels,\tcash\tflow\tconditions\tand\teconomic\tand\tindustry\ttrends.\n\nThe\tfollowing\ttable\tsummarizes\tthe\tCompany's\tU.S.\tplan\tassets\tby\tcategory\tof\tinvestment\tand\tlevel\twithin\tthe\tfair\tvalue\thierarchy\tas\tof\tDecember\t31,\t2010\tand\t2009:\n\n|  | December\t31,\t2010 | December\t31,\t2010 | December\t31,\t2010 | December\t31,\t2010 | December\t31,\t2009 | December\t31,\t2009 | December\t31,\t2009 | December\t31,\t2009 |\n| :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- | :--- |\n| U.S.\\tPlans | Level\\t1 | Level\\t2 | Level\\t3 | Total | Level\\t1 | Level\\t2 | Level\\t3 | Total |\n|  |  |  |  | (in\\tmillions) | (in\\tmillions) |  |  |  |\n| Equity\\tsecurities: |  |  |  |  |  |  |  |  |\n| Common\\tstock | $160 | $36 | $ — | $196 | $189 | $31 | $ — | $220 |\n| Mutual\\tfunds | 39 | \\t — | \\t — | 39 | 3 | \\t — | \\t — | 3 |\n| Debt\\tsecurities: |  |  |  |  |  |  |  |  |\n| Government\\tdebt\\tsecurities | 38 | \\t — | \\t — | 38 | 48 | \\t — | \\t — | 48 |\n| Corporate\\tdebt\\tsecurities | 66 | \\t — | \\t — | 66 | 71 | \\t — | \\t — | 71 |\n| Mutual\\tfunds^(1) | 2 | \\t — | \\t — | 2 | 2 | \\t — | \\t — | 2 |\n| Other\\tdebt\\tsecurities | 11 | \\t — | \\t — | 11 | 15 | \\t — | \\t — | 15 |\n| Other: |  |  |  |  |  |  |  |  |\n| Cash\\tand\\tcash\\tequivalents | 70 | \\t — | \\t — | 70 | 17 | \\t — | \\t — | 17 |\n| Other\\tinvestments | \\t — | 16 | \\t — | 16 | \\t — | 16 | \\t — | 16 |\n| Total\\tplan\\tassets | $386 | $52 | $ — | $438 | $345 | $47 | $ — | $392 |\n\nMutual\tfunds\tcategorized\tas\tdebt\tsecurities\tcons